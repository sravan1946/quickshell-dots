#%PAM-1.0
# /etc/pam.d/sudo: a finger first (15 s, then the password), with the island bar's card
# following along through sudo-bar-hook
auth		optional	pam_exec.so quiet /usr/local/bin/sudo-bar-hook finger
auth		sufficient	pam_fprintd.so max-tries=2 timeout=15
auth		optional	pam_exec.so quiet /usr/local/bin/sudo-bar-hook pass
auth		include		system-auth
account		include		system-auth
session		include		system-auth
session		optional	pam_systemd.so class=none
session		optional	pam_exec.so quiet type=open_session /usr/local/bin/sudo-bar-hook ok
